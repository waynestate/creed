# What a Composer consumer actually receives.
#
# `export-ignore` only affects the dist archive built from a tag. It keeps the
# package to what the package is: the policy, the schema, the reader and the
# readme. Nothing here changes what is in the repository.

* text=auto eol=lf

# Windows developer scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# The vendored Preflight a11y checker stays LF; tests/A11yCheckerPinTest.php pins its bytes.
tools/a11y/check.mjs text eol=lf

# Not part of the package.
/tests            export-ignore
/handbook         export-ignore
/tools            export-ignore
/composer.lock    export-ignore
/phpunit.xml.dist export-ignore
/.gitattributes   export-ignore
/.gitignore       export-ignore

# README art: the images and the kit that makes them.
/docs/readme        export-ignore
/scripts/readme-art export-ignore

# bin/export.php ships because consumers run its --check from
# vendor/waynestate/creed/bin/export.php; the other bin scripts are
# maintainer tools. git archive skips an export-ignore directory without
# looking inside it, so each of them gets its own line here.
/bin/agent-ready.php       export-ignore
/bin/build-handbook-site.php export-ignore
/bin/docs-site.php          export-ignore
/bin/lint-handbook.php      export-ignore
/bin/mysql56-probe.php      export-ignore
/bin/policy-bot.php         export-ignore
/bin/refresh-common.php     export-ignore
/bin/refresh-patches.php    export-ignore
/bin/refresh-policy.php     export-ignore
/bin/validate-policy.php    export-ignore
/site export-ignore
