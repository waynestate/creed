# What a Composer consumer actually receives.
#
# `export-ignore` only affects the dist archive built from a tag. It keeps the
# package to what the package is: the policy, the schema, the reader and the
# readme. Nothing here changes what is in the repository.

* text=auto eol=lf

# Windows developer scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Not part of the package.
/tests            export-ignore
/handbook         export-ignore
/bin              export-ignore
/composer.lock    export-ignore
/phpunit.xml.dist export-ignore
/.gitattributes   export-ignore
/.gitignore       export-ignore

# README art: the images and the kit that makes them.
/docs/readme        export-ignore
/scripts/readme-art export-ignore
