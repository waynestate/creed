{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "CREED refresh provenance ledger",
    "type": "object",
    "required": [
        "schema_version",
        "observations"
    ],
    "additionalProperties": false,
    "properties": {
        "schema_version": {
            "const": 1
        },
        "updated_on": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "observations": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "additionalProperties": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "object",
                            "required": [
                                "value",
                                "first_seen",
                                "last_seen"
                            ],
                            "additionalProperties": false,
                            "properties": {
                                "value": {
                                    "type": "string"
                                },
                                "first_seen": {
                                    "type": "string",
                                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                                },
                                "last_seen": {
                                    "type": "string",
                                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
