{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "CREED version policy",
    "type": "object",
    "required": [
        "schema_version",
        "components",
        "rules"
    ],
    "additionalProperties": false,
    "properties": {
        "schema_version": {
            "const": 1
        },
        "refreshed_on": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "components": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
                "type": "object",
                "required": [
                    "versions"
                ],
                "additionalProperties": false,
                "properties": {
                    "versions": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "released": {
                                    "type": "string",
                                    "format": "date"
                                },
                                "active_until": {
                                    "type": "string",
                                    "format": "date"
                                },
                                "security_until": {
                                    "type": "string",
                                    "format": "date"
                                },
                                "latest_patch": {
                                    "type": "string"
                                },
                                "latest_patch_checked": {
                                    "type": "string",
                                    "format": "date"
                                },
                                "current": {
                                    "type": "boolean"
                                },
                                "images": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "citadel": {
                                            "type": "string",
                                            "minLength": 1
                                        },
                                        "docker": {
                                            "type": "string",
                                            "minLength": 1
                                        },
                                        "openshift": {
                                            "type": "string",
                                            "minLength": 1
                                        },
                                        "coolify": {
                                            "type": "string",
                                            "minLength": 1
                                        }
                                    }
                                },
                                "requires": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "php": {
                                            "type": "object",
                                            "required": [
                                                "min",
                                                "max"
                                            ],
                                            "additionalProperties": false,
                                            "properties": {
                                                "min": {
                                                    "type": "string",
                                                    "pattern": "^\\d+(\\.\\d+)*$"
                                                },
                                                "max": {
                                                    "type": "string",
                                                    "pattern": "^\\d+(\\.\\d+)*$"
                                                }
                                            }
                                        },
                                        "mysql": {
                                            "type": "string",
                                            "pattern": "^\\d+(\\.\\d+)*$"
                                        },
                                        "mariadb": {
                                            "type": "string",
                                            "pattern": "^\\d+(\\.\\d+)*$"
                                        }
                                    }
                                }
                            },
                            "if": {
                                "properties": {
                                    "current": {
                                        "const": true
                                    }
                                },
                                "required": [
                                    "current"
                                ]
                            },
                            "then": {
                                "not": {
                                    "required": [
                                        "security_until"
                                    ]
                                }
                            },
                            "else": {
                                "required": [
                                    "security_until"
                                ]
                            }
                        }
                    }
                }
            }
        },
        "tools": {
            "type": "object",
            "propertyNames": {
                "pattern": "^[a-z][a-z0-9-]*$"
            },
            "additionalProperties": {
                "type": "object",
                "required": [
                    "minimum"
                ],
                "additionalProperties": false,
                "properties": {
                    "minimum": {
                        "type": "string",
                        "pattern": "^\\d+\\.\\d+\\.\\d+$"
                    }
                }
            }
        },
        "sessions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "sesame": {
                    "type": "object",
                    "required": [
                        "idle_minutes",
                        "absolute_minutes",
                        "source"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "idle_minutes": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "absolute_minutes": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "source": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                },
                "gateway": {
                    "type": "object",
                    "required": [
                        "idle_seconds",
                        "session_seconds",
                        "source"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "idle_seconds": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "session_seconds": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "source": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                }
            }
        },
        "rules": {
            "type": "object",
            "required": [
                "audit_severity_threshold",
                "banned_constraints",
                "eol_grace_days"
            ],
            "additionalProperties": false,
            "properties": {
                "abandoned_packages": {
                    "type": "string",
                    "enum": [
                        "ignore",
                        "report",
                        "fail"
                    ]
                },
                "audit_severity_threshold": {
                    "type": "string"
                },
                "banned_constraints": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "eol_grace_days": {
                    "type": "integer",
                    "minimum": 0
                },
                "override_max_days": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Longest an override may run, in days past the day PROCTOR runs. A longer override fails the overrides check."
                }
            }
        }
    }
}
