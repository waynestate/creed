{
    "name": "waynestate/creed",
    "description": "The Wayne State app stack version policy as data, with a framework-free PHP reader.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Wayne State University, Enterprise Applications"
        }
    ],
    "require": {
        "php": "^8.3",
        "composer/semver": "^3.5"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "opis/json-schema": "^2.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Waynestate\\Creed\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waynestate\\Creed\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "validate-policy": "php bin/validate-policy.php",
        "lint": "pint --test",
        "fix": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
