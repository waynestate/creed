{
    "name": "waynestate/creed",
    "description": "The Wayne State app stack version policy as data, with a framework-free PHP reader.",
    "homepage": "https://creed.apps.wayne.edu/",
    "support": {
        "source": "https://github.com/waynestate/creed"
    },
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Wayne State University, Enterprise Applications"
        }
    ],
    "require": {
        "php": "^8.3",
        "composer/semver": "^3.5"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "opis/json-schema": "^2.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "waynestate/pinstripe": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Waynestate\\Creed\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waynestate\\Creed\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "ci": [
            "@composer validate --strict",
            "@test",
            "@validate-policy",
            "@lint",
            "@lint-handbook",
            "@analyse",
            "@composer audit"
        ],
        "test": "phpunit",
        "validate-policy": "php bin/validate-policy.php",
        "export": "php bin/export.php",
        "lint": "pint --test",
        "lint-handbook": "php bin/lint-handbook.php",
        "fix": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "scripts-descriptions": {
        "ci": "The full CI gate: validate, tests, policy schema, Pint, PHPStan, audit. Same command on GitLab and GitHub."
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
