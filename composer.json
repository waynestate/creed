{
    "name": "waynestate/creed",
    "description": "The Wayne State app stack version policy as data, with a framework-free PHP reader.",
    "homepage": "https://creed.apps.wayne.edu/",
    "support": {
        "source": "https://github.com/waynestate/creed"
    },
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Wayne State University, Enterprise Applications"
        }
    ],
    "require": {
        "php": "^8.3",
        "composer/semver": "^3.5"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "league/commonmark": "^2.7",
        "opis/json-schema": "^2.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "waynestate/pinstripe": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Waynestate\\Creed\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waynestate\\Creed\\Tests\\": "tests/",
            "Waynestate\\Creed\\Tools\\": "tools/"
        }
    },
    "scripts": {
        "ci": [
            "@composer validate --strict",
            "@test",
            "@validate-policy",
            "@lint",
            "@lint-handbook",
            "@site:handbook-check",
            "@site:agent-ready-check",
            "@analyse",
            "@composer audit"
        ],
        "test": "phpunit",
        "validate-policy": "php bin/validate-policy.php",
        "export": "php bin/export.php",
        "lint": "pint --test",
        "lint-handbook": "php bin/lint-handbook.php",
        "site:handbook": "php bin/build-handbook-site.php",
        "site:handbook-check": "php bin/build-handbook-site.php --check",
        "site:agent-ready": "php bin/agent-ready.php",
        "site:agent-ready-check": "php bin/agent-ready.php --check",
        "fix": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "scripts-descriptions": {
        "ci": "The full CI gate: validate, tests, policy schema, Pint, handbook lint, handbook site freshness, agent-ready files, PHPStan, audit. Same command on GitLab and GitHub.",
        "site:handbook": "Rebuild site/handbook/ from handbook/*.md.",
        "site:handbook-check": "Fail when site/handbook/ is stale against handbook/*.md.",
        "site:agent-ready": "Rewrite the Markdown twins, llms.txt, llms-full.txt, robots.txt and sitemap.xml in site/ (SQUIRE's agent-ready kit).",
        "site:agent-ready-check": "Fail when the agent-ready files are stale, a page lacks its Markdown link, a prompt drifts from the docs, or the kit was edited here."
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
